{
  "manifest_version": 3,
  "name": "Selah",
  "version": "1.2.0",
  "description": "Een rustig, christelijk dashboard met Bijbelteksten, reflectie en natuur.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://bible.helloao.org/*",
    "https://api.unsplash.com/*",
    "https://images.unsplash.com/*",
    "https://plus.unsplash.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
